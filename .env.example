# Cloudflare Pages Functions secrets (set in the Cloudflare dashboard, never VITE_):
# SUPABASE_SECRET_KEY=sb_secret_...  (Nazar-production only)
# TURNSTILE_SECRET_KEY=...       (Nazar website widget only)
# CLOVER_ORDERS_ACCESS_TOKEN=... (production OAuth token, read-orders permission; server secret only)
# CLOVER_MERCHANT_ID=...         (Nazar production merchant ID)
# CLOVER_ONLINE_ORDER_TYPE_IDS=... (comma-separated verified Clover pickup/delivery order-type IDs)

