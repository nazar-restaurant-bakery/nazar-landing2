# Cloudflare Pages Functions secrets (set in the Cloudflare dashboard, never VITE_):
# SUPABASE_SECRET_KEY=sb_secret_...  (Nazar-production only)
# TURNSTILE_SECRET_KEY=...       (Nazar website widget only)
# CLOVER_ORDERS_ACCESS_TOKEN=... (production OAuth token, read-orders permission; server secret only)
# CLOVER_MERCHANT_ID=...         (Nazar production merchant ID)
# CLOVER_ONLINE_ORDER_TYPE_IDS=... (comma-separated verified Clover pickup/delivery order-type IDs)

# Isolated Preview ONLY. Never add production secrets to Preview. Values below
# are placeholders; the test project is created only after Talip's decision.
# VITE_APP_ENV=isolated-test
# VITE_TEST_SUPABASE_URL=https://<TEST_PROJECT_REF>.supabase.co
# VITE_TEST_SUPABASE_ANON_KEY=sb_publishable_<TEST_PROJECT_ONLY>
# VITE_TEST_BUSINESS_ID=<SYNTHETIC_TENANT_UUID>
# VITE_TEST_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Server-only Preview bindings; do not prefix secrets with VITE_:
# APP_ENV=isolated-test
# TEST_SUPABASE_URL=https://<TEST_PROJECT_REF>.supabase.co
# TEST_BUSINESS_ID=<SYNTHETIC_TENANT_UUID>
# TEST_SUPABASE_SECRET_KEY=sb_secret_<TEST_PROJECT_ONLY>
# TEST_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TEST_TURNSTILE_EXPECTED_HOSTNAME=<EXACT_HOSTNAME_FROM_DUMMY_SITEVERIFY_RESPONSE>

# K5 server-only profile attributes. Missing mode stays disabled; see K5_PROFILE_SYNC.md.
# Never place a private key in a VITE_ variable. No hosted bindings set by this branch.
# KLAVIYO_PROFILE_SYNC_MODE=disabled
# KLAVIYO_PROFILE_SYNC_ACCOUNT_ID=<HUMAN_VERIFIED_ACCOUNT_LABEL>
# KLAVIYO_PROFILE_SYNC_KEY=pk_<DEDICATED_PROFILES_READ_WRITE_KEY>
# KLAVIYO_PROFILE_SYNC_LIVE_APPROVAL_ID=<RECORDED_APPROVAL_REFERENCE>
# KLAVIYO_PROFILE_SYNC_CUSTOMER_ID=<OPTIONAL_EXACT_CUSTOMER_UUID>
