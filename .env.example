# Copy this file to .env.local and fill in the values.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# Supabase project URL
VITE_SUPABASE_URL=https://zvsvciufzbxjmrlbwxgy.supabase.co

# Publishable / anon key. Safe to ship in the browser: the signups table only
# grants INSERT to the anon role, and row-level security blocks everything else.
VITE_SUPABASE_ANON_KEY=sb_publishable_oF4hHNL1_e2pwUSliF6q2g_eal6M6ze

# core.businesses.id for Nazar Restaurant & Bakery — stamped on every signup row.
VITE_NAZAR_BUSINESS_ID=a358eba4-b197-4309-805b-46f43a718454
